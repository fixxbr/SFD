enum BackupJobKind {
  FULL
  DATA_ONLY
  DOCUMENTS_ONLY
  EXCEL
  CSV
  PRE_RESTORE
}

enum BackupJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

enum RestoreMode {
  MERGE
  MISSING_ONLY
  UPDATE_EXISTING
  FULL
}

enum RestoreJobStatus {
  VALIDATING
  PREVIEW_READY
  IMPORTING
  VERIFYING
  COMPLETED
  FAILED
}

model BackupJob {
  id              String          @id @default(uuid()) @db.Uuid
  kind            BackupJobKind   @default(FULL)
  status          BackupJobStatus @default(PENDING)
  filename        String?
  byteSize        Int?            @map("byte_size")
  candidateCount  Int             @default(0) @map("candidate_count")
  documentCount   Int             @default(0) @map("document_count")
  caseCount       Int             @default(0) @map("case_count")
  paymentCount    Int             @default(0) @map("payment_count")
  filesIncluded   Int             @default(0) @map("files_included")
  filesMissing    Int             @default(0) @map("files_missing")
  manifestJson    Json?           @map("manifest_json")
  warningReport   Json?           @map("warning_report")
  errorMessage    String?         @map("error_message")
  requestedById   String          @map("requested_by_id") @db.Uuid
  startedAt       DateTime?       @map("started_at")
  finishedAt      DateTime?       @map("finished_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  requestedBy AdminUser @relation("BackupRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([requestedById])
  @@map("backup_jobs")
}

model RestoreJob {
  id               String           @id @default(uuid()) @db.Uuid
  status           RestoreJobStatus @default(VALIDATING)
  mode             RestoreMode      @default(MERGE)
  sourceFilename   String?          @map("source_filename")
  byteSize         Int?             @map("byte_size")
  summaryJson      Json?            @map("summary_json")
  resultJson       Json?            @map("result_json")
  errorMessage     String?          @map("error_message")
  preRestoreBackupId String?        @map("pre_restore_backup_id") @db.Uuid
  confirmationText String?          @map("confirmation_text")
  requestedById    String           @map("requested_by_id") @db.Uuid
  startedAt        DateTime?        @map("started_at")
  finishedAt       DateTime?        @map("finished_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  requestedBy AdminUser @relation("RestoreRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([requestedById])
  @@map("restore_jobs")
}

/// Durable binary objects (documents, receipt attachments) persisted in Neon BYTEA.
/// Metadata tables keep storageKey → this row; list APIs never SELECT content.
model StoredObject {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  mimeType  String?  @map("mime_type")
  content   Bytes
  checksum  String
  byteSize  Int      @map("byte_size")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([checksum])
  @@map("stored_objects")
}
